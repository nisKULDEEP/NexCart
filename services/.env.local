# Local Development Environment - COPY TO .env FOR CUSTOMIZATION
# This file contains example values. Create a .env file with your local overrides.
# ⚠️ WARNING: DO NOT commit actual passwords to version control
# ⚠️ For production, use cloud provider secrets management

# PostgreSQL Credentials
DB_USER=niskuldeep
DB_PASSWORD=niskuldeep
DB_HOST=localhost
DB_PORT=5432

# MongoDB Credentials
MONGO_USER=niskuldeep
MONGO_PASSWORD=niskuldeep
MONGO_HOST=localhost
MONGO_PORT=27017

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Elasticsearch
ELASTICSEARCH_HOST=localhost
ELASTICSEARCH_PORT=9200

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Mail (Notification Service)
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=example
MAIL_PASSWORD=example

# Grafana
GRAFANA_ADMIN_PASSWORD=admin

# Service Ports
CONFIG_SERVER_PORT=8888
DISCOVERY_PORT=8761
GATEWAY_PORT=8222
ORDER_SERVICE_PORT=8070
PAYMENT_SERVICE_PORT=8080
PRODUCT_SERVICE_PORT=8090
CUSTOMER_SERVICE_PORT=8085
NOTIFICATION_SERVICE_PORT=8095

# Application Profiles
SPRING_PROFILES_ACTIVE=dev

