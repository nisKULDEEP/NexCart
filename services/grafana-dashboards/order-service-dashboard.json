{
  "dashboard": {
    "title": "Order Service Metrics",
    "description": "Real-time monitoring of order service performance and health",
    "timezone": "browser",
    "panels": [
      {
        "id": 1,
        "title": "Request Rate (req/min)",
        "targets": [
          {
            "expr": "rate(http_server_requests_seconds_count{job=\"order-service\"}[1m]) * 60"
          }
        ],
        "type": "graph"
      },
      {
        "id": 2,
        "title": "Response Time p95 (ms)",
        "targets": [
          {
            "expr": "histogram_quantile(0.95, rate(http_server_requests_seconds_bucket{job=\"order-service\"}[5m])) * 1000"
          }
        ],
        "type": "graph"
      },
      {
        "id": 3,
        "title": "Response Time p99 (ms)",
        "targets": [
          {
            "expr": "histogram_quantile(0.99, rate(http_server_requests_seconds_bucket{job=\"order-service\"}[5m])) * 1000"
          }
        ],
        "type": "graph"
      },
      {
        "id": 4,
        "title": "Error Rate (%)",
        "targets": [
          {
            "expr": "rate(http_server_requests_seconds_count{job=\"order-service\",status=~\"5..\"}[5m]) * 100"
          }
        ],
        "type": "graph"
      },
      {
        "id": 5,
        "title": "JVM Memory Usage (MB)",
        "targets": [
          {
            "expr": "jvm_memory_used_bytes{job=\"order-service\"} / 1024 / 1024"
          }
        ],
        "type": "graph"
      },
      {
        "id": 6,
        "title": "Active Threads",
        "targets": [
          {
            "expr": "jvm_threads_live{job=\"order-service\"}"
          }
        ],
        "type": "graph"
      }
    ]
  }
}

